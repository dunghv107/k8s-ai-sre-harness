# Copy to .env (git-ignored); values become Sealed Secrets at bootstrap.

OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-terra
# Model for protected (security) incidents.
OPENAI_MODEL_ESCALATE=gpt-6.1-sol
# Over the cap, incidents are still reported but not diagnosed.
AGENT_DAILY_COST_CAP_USD=2

# Alertmanager posts raw alerts with this bot.
TELEGRAM_BOT_TOKEN=
# The agent posts diagnoses as a second bot; empty falls back to TELEGRAM_BOT_TOKEN.
TELEGRAM_AGENT_BOT_TOKEN=
# Group chat IDs are negative.
TELEGRAM_ALERT_CHAT_ID=
# Only these user IDs may send commands.
TELEGRAM_ALLOWED_USER_IDS=

AGENT_TIMEZONE=Asia/Ho_Chi_Minh
AGENT_BATCH_WINDOW_SECONDS=60
AGENT_MAX_PARALLEL_SUBAGENTS=5
AGENT_SUBAGENT_TIMEOUT_SECONDS=300
AGENT_WORKDAY_START=08:30
AGENT_WORKDAY_END=17:30
# Lets the repo run without OpenAI or Telegram credentials.
AGENT_DEMO_MODE=false

GRAFANA_URL=https://grafana.localhost
# Viewer role only.
GRAFANA_SA_TOKEN=
GRAFANA_ADMIN_PASSWORD=

# Investigation engine: fallback (default: native, HolmesGPT once as backup) | native | holmes | both (see docs/harness/tong-quan.md).
AGENT_ENGINE=fallback
# Random key shared by HolmesGPT and the agent; scripts/deploy-holmes.sh generates it when empty.
HOLMES_API_KEY=
